; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --include-generated-funcs --version 5
;; The MachineOutliner used to emit PseudoTAIL for outlined tail calls in
;; capability mode, failing with "Attempting to emit PseudoTAIL instruction but
;; the Feature_NotCapMode predicate(s) are not met" (found while compiling
;; BusyBox with -Oz).
; RUN: %riscv64_cheri_purecap_llc -verify-machineinstrs < %s | FileCheck %s
; RUN: %riscv64_cheri_purecap_llc -verify-machineinstrs -filetype=obj < %s \
; RUN:   | llvm-objdump -d -r --no-show-raw-insn - | FileCheck %s --check-prefix=OBJ

;; The outlined tail calls must expand to AUIPCC+CJALR via ct1.
; OBJ-LABEL: <f1>:
; OBJ-NEXT:    auipc ct1, 0x0
; OBJ-NEXT:    jr 0x{{[0-9a-f]+}}(ct1)
; OBJ-LABEL: <f2>:
; OBJ-NEXT:    auipc ct1, 0x0
; OBJ-NEXT:    jr 0x{{[0-9a-f]+}}(ct1)
; OBJ-LABEL: <OUTLINED_FUNCTION_0>:
; OBJ:         auipc ct1, 0x0
; OBJ-NEXT:      R_RISCV_CALL_PLT foo
; OBJ-NEXT:    jr ct1

declare void @foo(i32, i32, i32, i32) addrspace(200)

define void @f1() addrspace(200) minsize nounwind {
  tail call void @foo(i32 5, i32 6, i32 7, i32 8)
  ret void
}

define void @f2() addrspace(200) minsize nounwind {
  tail call void @foo(i32 5, i32 6, i32 7, i32 8)
  ret void
}
; CHECK-LABEL: f1:
; CHECK:       # %bb.0:
; CHECK-NEXT:    tail OUTLINED_FUNCTION_0
;
; CHECK-LABEL: f2:
; CHECK:       # %bb.0:
; CHECK-NEXT:    tail OUTLINED_FUNCTION_0
;
; CHECK-LABEL: OUTLINED_FUNCTION_0:
; CHECK:       # %bb.0:
; CHECK-NEXT:    li a0, 5
; CHECK-NEXT:    li a1, 6
; CHECK-NEXT:    li a2, 7
; CHECK-NEXT:    li a3, 8
; CHECK-NEXT:    tail foo
