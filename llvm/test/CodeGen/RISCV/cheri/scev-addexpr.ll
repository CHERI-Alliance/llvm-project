; CHECK-NEXT:    br label [[PREHEADER]]
; CHECK:       for:
; CHECK-NEXT:    [[LSR_IV1:%.*]] = phi ptr addrspace(200) [ [[SCEVGEP2:%.*]], [[FOR]] ], [ [[SCEVGEP]], [[PREHEADER]] ]
; CHECK-NEXT:    [[LSR_IV:%.*]] = phi i64 [ [[LSR_IV_NEXT:%.*]], [[FOR]] ], [ [[TMP3]], [[PREHEADER]] ]
; CHECK-NEXT:    [[TMP6:%.*]] = load double, ptr addrspace(200) [[LSR_IV1]], align 8
; CHECK-NEXT:    [[LSR_IV_NEXT]] = add i64 [[LSR_IV]], [[Z]]
