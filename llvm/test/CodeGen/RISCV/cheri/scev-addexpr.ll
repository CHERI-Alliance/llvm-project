; CHECK-NEXT:    [[TMP4:%.*]] = shl i64 [[I]], 3
; CHECK-NEXT:    [[TMP5:%.*]] = add i64 [[TMP1]], [[TMP4]]
; CHECK-NEXT:    [[SCEVGEP:%.*]] = getelementptr i8, ptr addrspace(200) [[CALL]], i64 [[TMP5]]
; CHECK-NEXT:    br label [[FOR:%.*]]
; CHECK:       cond:
