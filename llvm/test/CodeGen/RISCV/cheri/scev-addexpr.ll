; CHECK-NEXT:    [[TMP0:%.*]] = sub i64 0, [[END]]
; CHECK-NEXT:    [[TMP1:%.*]] = mul i64 [[X]], -8
; CHECK-NEXT:    [[TMP2:%.*]] = shl i64 [[Z]], 3
; CHECK-NEXT:    br label [[PREHEADER:%.*]]
