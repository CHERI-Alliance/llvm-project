entry:
  %call = call ptr addrspace(200) @bar()
  br label %preheader

preheader:
  %i = phi i64 [ %add, %cond ], [ %y, %entry ]
  br label %for

cond:
  %add = add nsw i64 %u, %v
  br label %preheader

for:
  %iv = phi i64 [ %iv.next, %for ], [ %i, %preheader ]
  %0 = sub nsw i64 %iv, %x
  %arrayidx = getelementptr inbounds double, ptr addrspace(200) %call, i64 %0
  %1 = load double, ptr addrspace(200) %arrayidx, align 8
  %iv.next = add i64 %iv, %z
  %cmp = icmp eq i64 %iv.next, %end
  br i1 %cmp, label %cond, label %for
}

declare ptr addrspace(200) @bar() addrspace(200)
