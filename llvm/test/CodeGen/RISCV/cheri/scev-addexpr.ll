target triple = "riscv64-unknown-freebsd"

define i32 @foo(i64 %x, i64 %y, i64 %z, i64 %u, i64 %v, i64 %end) {
; CHECK-LABEL: define i32 @foo
; CHECK-SAME: (i64 [[X:%.*]], i64 [[Y:%.*]], i64 [[Z:%.*]], i64 [[U:%.*]], i64 [[V:%.*]], i64 [[END:%.*]]) addrspace(200) #[[ATTR0:[0-9]+]] {
