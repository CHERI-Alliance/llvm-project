; CHECK-NEXT:    .cfi_offset ra, -16
; CHECK-NEXT:    ld a5, 16(csp)
; CHECK-NEXT:    mv a4, t6
; CHECK-NEXT:    mv a3, t5
; CHECK-NEXT:    mv a2, t4
; CHECK-NEXT:    mv a1, t3
; CHECK-NEXT:    mv a0, t2
